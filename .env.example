# Local AI through Ollama. No API key is needed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:4b
OLLAMA_TIMEOUT=180

# Gmail (optional): path to the OAuth client JSON you download from
# Google Cloud Console (Credentials -> OAuth client ID -> Desktop app).
# Or save it as data/gmail_client_secrets.json and leave this unset.
# GMAIL_CLIENT_SECRETS=/path/to/client_secret.json
